ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=sqlite:///./jobpilot.db
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Telegram notifications (optional) ────────────────────────────────────────
# Create a bot at https://t.me/BotFather → /newbot
# Then message your bot once and visit:
#   https://api.telegram.org/bot<TOKEN>/getUpdates   (copy chat_id from result)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SMTP / Email notifications (optional fallback) ───────────────────────────
# Use Gmail app-password, SendGrid, Mailgun, or any SMTP relay.
# Port 465 → SSL, 587 → STARTTLS, other → plain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com
